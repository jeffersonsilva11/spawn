# ===================================
# INDIE UNITY GAME BACKEND PLATFORM
# Environment Configuration
# ===================================

# ----------------
# Environment
# ----------------
NODE_ENV=development

# ----------------
# Backend API
# ----------------
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ----------------
# Database
# ----------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gamebackend
DB_PASSWORD=gamebackend_password
DB_NAME=gamebackend
DB_SYNCHRONIZE=true  # Set to false in production
DB_LOGGING=false

# ----------------
# Orchestrator
# ----------------
ORCHESTRATOR_PORT=3001
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_SECRET=change-this-to-a-secure-orchestrator-secret

# Orchestrator URL (from Backend perspective)
ORCHESTRATOR_URL=http://localhost:3001

# Docker Configuration
DOCKER_SOCKET=/var/run/docker.sock
UNITY_SERVER_PORT_RANGE_START=7000
UNITY_SERVER_PORT_RANGE_END=8000
UNITY_SERVER_NETWORK=game-backend-network

# Container Resource Limits
CONTAINER_CPU_LIMIT=1  # CPU cores
CONTAINER_MEMORY_LIMIT=2g  # Memory limit

# Health Check Configuration
HEARTBEAT_TIMEOUT_SECONDS=60
HEALTH_CHECK_INTERVAL_SECONDS=30

# ----------------
# Web Panel
# ----------------
WEB_PANEL_PORT=3002
REACT_APP_API_URL=http://localhost:3000

# ----------------
# AWS Configuration
# ----------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 Build Storage
S3_BUCKET_NAME=unity-game-builds
S3_BUILDS_PREFIX=builds/

# ----------------
# Server Configuration
# ----------------
PUBLIC_IP=localhost  # Change to EC2 public IP in production
MAX_SERVERS_PER_STUDIO=10  # Default limit

# ----------------
# CORS
# ----------------
CORS_ORIGIN=http://localhost:3002,http://localhost:3000

# ----------------
# Logging
# ----------------
LOG_LEVEL=info  # debug, info, warn, error
